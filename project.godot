; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DARTSTORM: Elemental Arena"
config/description="A colourful, family-friendly foam-dart arena shooter."
config/version="1.0.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://assets/branding/icon_512.png"
boot_splash/bg_color=Color(0.0431373, 0.121569, 0.294118, 1)
boot_splash/image="res://assets/branding/boot_splash.png"
boot_splash/fullsize=true
boot_splash/show_image=true
config/use_custom_user_dir=true
config/custom_user_dir_name="dartstorm"

[autoload]

GameSettings="*res://scripts/core/game_settings.gd"
Sfx="*res://scripts/core/sfx.gd"
Progression="*res://scripts/core/progression.gd"
NetworkManager="*res://scripts/network/network_manager.gd"
ModelLoader="*res://scripts/core/model_loader.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="actors"
3d_physics/layer_3="targets"
3d_physics/layer_4="pickups"
3d_physics/layer_5="hitboxes"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.mobile=0
anti_aliasing/quality/msaa_3d.web=0
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/screen_space_aa.mobile=0
anti_aliasing/quality/screen_space_aa.web=0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/size.web=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.web=0
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/atlas_size.mobile=2048
lights_and_shadows/positional_shadow/atlas_size.web=1024


